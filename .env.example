# Server Port
PORT=8787

# MongoDB Connection String
# Example local: mongodb://127.0.0.1:27017/slang
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/slang?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/slang
MONGODB_DB=slang

# HMAC & Token Secret (Auto-generated fallback used if omitted)
# WAITLIST_SECRET=your_high_entropy_secret_here

# Resend API Key for automated welcome emails
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM=Slang <onboarding@resend.dev>

# Allowed origins for CORS/CSRF (comma-separated, empty allows same-origin and dev)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787
